{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "appearance": {
    "default": "light",
    "strict": true
  },
  "name": "Trails",
  "colors": {
    "primary": "#6C00F6",
    "light": "#CDA7FF",
    "dark": "#3A0084"
  },
  "favicon": "/favicon.ico",

  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Demo Playground",
          "icon": "square-terminal",
          "href": "https://demo.trails.build/widget"
        },
        {
          "anchor": "Trails Status",
          "icon": "heart-pulse",
          "href": "https://status.trails.build"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Welcome",
            "pages": ["intro", "get-started"]
          },
          {
            "group": "Use Cases",
            "pages": [
              "use-cases/pay",
              "use-cases/swap",
              "use-cases/fund",
              "use-cases/earn",
              "use-cases/composable-actions",
              "overview/cross-chain-execution"
            ]
          },
          {
            "group": "Examples",
            "pages": [
              "examples/gasless",
              "examples/wallet-compatibility",
              "examples/transaction-history",
              "examples/tokens-chains-prices",
              "examples/refunds",
              "examples/x402"
            ]
          },
          {
            "group": "Architecture",
            "pages": [
              "architecture/how-it-works",
              "architecture/protocol",
              "architecture/v1-5",
              "architecture/pricing-fees",
              "architecture/alt-fee-tokens",
              "architecture/unified-liquidity",
              "architecture/edge-alt-vms",
              "architecture/smart-contracts"
            ]
          },
          {
            "group": "Resources",
            "pages": ["resources/supported-chains", "resources/llm-integration", "resources/v1-5-migration"]
          }
        ]
      },
      {
        "tab": "SDK",
        "groups": [
          {
            "group": "SDK Documentation",
            "pages": [
              "sdk/get-started",
              "sdk/configuration",
              "sdk/hooks",
              {
                "group": "Adapters",
                "pages": [
                  "sdk/adapters/overview",
                  "sdk/adapters/wagmi",
                  "sdk/adapters/solana",
                  "sdk/adapters/eip-1193",
                  "sdk/adapters/dynamic",
                  "sdk/adapters/thirdweb"
                ]
              },
              {
                "group": "Composable Actions",
                "pages": [
                  "sdk/composable-actions/overview",
                  "sdk/composable-actions/quickstart",
                  "sdk/composable-actions/building-actions",
                  "sdk/composable-actions/dynamic-values",
                  "sdk/composable-actions/markets-and-providers",
                  "sdk/composable-actions/erc20-helpers",
                  "sdk/composable-actions/supported-chains"
                ]
              },
              {
                "group": "Modes",
                "pages": [
                  "sdk/modes/pay",
                  "sdk/modes/fund",
                  "sdk/modes/swap",
                  "sdk/modes/earn",
                  "sdk/modes/withdraw"
                ]
              },
              "sdk/theming",
              "sdk/customization",
              "sdk/quote-providers",
              "sdk/tokens-and-chains",
              "sdk/changelog"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "description": "Trails API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/trails-api-sdk"
            ]
          },
          {
            "group": "Intents",
            "pages": [
              "api-reference/endpoints/quote-intent",
              "api-reference/endpoints/quote-intent-edge",
              "api-reference/endpoints/commit-intent",
              "api-reference/endpoints/execute-intent",
              "api-reference/endpoints/get-intent-receipt",
              "api-reference/endpoints/wait-intent-receipt",
              "api-reference/endpoints/get-edge-status",
              "api-reference/endpoints/get-edges",
              "api-reference/endpoints/get-intent",
              "api-reference/endpoints/search-intents",
              "api-reference/endpoints/get-intent-history"
            ]
          },
          {
            "group": "Routes & Tokens",
            "pages": [
              "api-reference/endpoints/get-exact-input-routes",
              "api-reference/endpoints/get-exact-output-routes",
              "api-reference/endpoints/get-token-list",
              "api-reference/endpoints/get-token-prices"
            ]
          },
          {
            "group": "Chains & Discovery",
            "pages": [
              "api-reference/endpoints/get-chains",
              "api-reference/endpoints/get-fiat-currency-list",
              "api-reference/endpoints/get-exchange-rate"
            ]
          },
          {
            "group": "Earn",
            "pages": [
              "api-reference/endpoints/yield-get-markets",
              "api-reference/endpoints/yield-get-market-by-id",
              "api-reference/endpoints/yield-get-networks",
              "api-reference/endpoints/yield-get-providers",
              "api-reference/endpoints/yield-get-provider",
              "api-reference/endpoints/yield-get-balances",
              "api-reference/endpoints/yield-create-enter-action",
              "api-reference/endpoints/yield-create-exit-action",
              "api-reference/endpoints/get-earn-pools"
            ]
          },
          {
            "group": "Intents (Advanced)",
            "pages": [
              "api-reference/endpoints/abort-intent",
              "api-reference/endpoints/retry-intent",
              "api-reference/endpoints/prepare-intent-recovery",
              "api-reference/endpoints/build-intent-recovery-transaction",
              "api-reference/endpoints/build-oif-refund-transaction"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light-mode.svg",
    "dark": "/logo/dark-mode.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://dashboard.trails.build"
      },
      {
        "label": "Explorer",
        "href": "https://app.trails.build/explorer"
      },
      {
        "label": "Support",
        "href": "https://t.me/build_with_trails"
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.trails.build"
    }
  },
  "redirects": [
    {
      "source": "/home",
      "destination": "/intro"
    },
    {
      "source": "/overview/1-click-payments",
      "destination": "/architecture/how-it-works"
    },
    {
      "source": "/overview/chain-abstraction",
      "destination": "/architecture/how-it-works"
    },
    {
      "source": "/sdk/composable-actions",
      "destination": "/sdk/composable-actions/overview"
    },
    {
      "source": "/use-cases/compose-actions",
      "destination": "/use-cases/composable-actions"
    }
  ],
  "footer": {
    "socials": {
      "website": "https://trails.build",
      "x": "https://x.com/TrailsHQ",
      "telegram": "https://t.me/build_with_trails",
      "linkedin": "https://www.linkedin.com/showcase/trailshq/"
    }
  }
}
